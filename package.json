{
  "name": "ev-charging-station-management",
  "version": "1.0.0",
  "description": "EV Charging Station Management and Software Metrics Platform",
  "scripts": {
    "start": "docker compose up --build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev:backend": "cd backend && uvicorn app.main:app --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && pytest -v --cov=app --cov-report=xml",
    "build:frontend": "cd frontend && npm run build"
  }
}